<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="HiveMQtt" Version="0.45.1" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\rPDU2MQTT.Core\rPDU2MQTT.Core.csproj" />
		<ProjectReference Include="..\rPDU2MQTT.Engine\rPDU2MQTT.Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- GUI assets are embedded so the binary serves them without a wwwroot on disk. app.js + styles.css
		     are BUILT from web/src/*.ts + web/styles.css by BuildGuiAssets (committed so a node-less build
		     still works); index.html is authored directly. -->
		<EmbeddedResource Include="wwwroot\index.html" />
		<EmbeddedResource Include="wwwroot\styles.css" />
		<EmbeddedResource Include="wwwroot\app.js" />
	</ItemGroup>

	<ItemGroup>
		<GuiSource Include="web\src\**\*.ts" />
		<GuiSource Include="web\styles.css" />
		<GuiSource Include="web\build.mjs" />
		<GuiSource Include="web\smoke.mjs" />
		<GuiSource Include="web\domstub.mjs" />
		<GuiSource Include="web\layout.check.mjs" />
		<GuiSource Include="web\sankey.check.mjs" />
			<GuiSource Include="web\update.check.mjs" />
			<GuiSource Include="web\animation.check.mjs" />
			<GuiSource Include="web\gauge.check.mjs" />
			<GuiSource Include="web\contradiction.check.mjs" />
			<GuiSource Include="web\tags.check.mjs" />
			<GuiSource Include="web\discover.check.mjs" />
			<GuiSource Include="web\energyshow.check.mjs" />
			<GuiSource Include="web\history.check.mjs" />
			<GuiSource Include="web\trends.check.mjs" />
			<GuiSource Include="web\mobile.check.mjs" />
			<GuiSource Include="web\sparkline.check.mjs" />
			<GuiSource Include="web\drilldown.check.mjs" />
			<GuiSource Include="web\emoncms.check.mjs" />
		<GuiSource Include="web\schema.fixture.json" />
	</ItemGroup>

	<!-- Build the GUI bundle (TypeScript ES modules -> wwwroot/app.js + minified styles.css) using only the
	     node binary (no npm; Node's built-in type-stripping). Skips gracefully when node isn't installed,
	     leaving the committed outputs in place. -->
	<Target Name="BuildGuiAssets" BeforeTargets="BeforeBuild" Inputs="@(GuiSource)" Outputs="wwwroot\app.js;wwwroot\styles.css">
		<Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="_NodeExitCode" />
		</Exec>
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- Run the bundle's smoke test against the real schema: it builds every section in a stubbed DOM,
		     so a broken cross-module reference fails the build here instead of blanking a tab at runtime. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/smoke.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- Layout regressions render fine and mean nothing: the hierarchy left-justified a feeder away from
		     what it powers, and a night-time (all-zero) solar chain sank to the bottom of the chart joined by
		     invisible ribbons. Both are asserted on the real bundle's rendered geometry. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/layout.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/sankey.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- The auto-update notice has no click behind it, so its only test is this transition table: #304
		     shipped one in prose and the case it missed (a moving channel, where the tag never changes) was
		     exactly the one that broke. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/update.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- Motion is a claim: an unknown link and a measured zero must stay still, or "no data" looks
		     busier than a real reading. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/animation.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- A gauge is only as honest as the ceiling it is drawn against, so it must never invent one. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/gauge.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/contradiction.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/tags.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/discover.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/energyshow.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/history.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/trends.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- A plugin is a drop-in DLL only for as long as no TypeScript names one. This renders a plugin the
		     GUI has never heard of and asserts it gets a nav entry, generated fields and its buttons. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/plugin.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- The chart on a phone: opened at its natural width inside a ~390px screen, with the only zoom
		     gesture being Ctrl/⌘ + wheel — neither half of which a touch device has. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/mobile.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- The tiles' trends: drawn from readings the backend has, absent when it has none, and a gap left
		     as a gap rather than joined through. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/sparkline.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- Clicking a tile has to chart the nodes that tile's figure came from, not whatever Trends was
		     showing — an answer about different nodes is worse than no link. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/drilldown.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- The bindings table carries its own width, and a column nothing on the node uses is not a column. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/nodesheet.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- "Hide empty" must clear switched-off outlets without hiding a node nothing measures, or cutting a
		     zero chain off the live thing it feeds. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/hideempty.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- A binding worked out from other bindings can be complete in itself and still produce nothing, so
		     the row has to say what it is still waiting for. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/derived.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- An EmonCMS binding names a feed on someone else's server, so a typo produces a row that looks
		     complete and a node that never has a value. The row has to check the name and say. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/emoncms.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- The landing page: what it says has to be what was measured, and a component in trouble has to be
		     impossible to scroll past. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/overview.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<!-- Layout rules a DOM stub cannot see: a sticky table header trapped inside its own table looked
		     fine in Firefox and sat on top of the first row in Chrome. -->
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/css.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Warning Condition="'$(_NodeExitCode)' != '0'" Text="node not found; using the committed wwwroot/app.js + styles.css. Install Node 22+ to rebuild the GUI from web/src." />
	</Target>

</Project>
