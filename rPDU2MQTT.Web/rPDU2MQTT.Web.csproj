		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/emoncmscleanup.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/nodeemontag.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/explorer.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/maprow.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/reconnect.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
