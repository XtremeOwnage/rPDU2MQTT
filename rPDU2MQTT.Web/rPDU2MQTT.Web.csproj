<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="HiveMQtt" Version="0.47.1" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.12" />
		<PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\rPDU2MQTT.Core\rPDU2MQTT.Core.csproj" />
		<ProjectReference Include="..\rPDU2MQTT.Engine\rPDU2MQTT.Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- app.js and styles.css are built from web/ by BuildGuiAssets; index.html is authored directly. -->
		<EmbeddedResource Include="wwwroot\index.html" />
		<EmbeddedResource Include="wwwroot\styles.css" />
		<EmbeddedResource Include="wwwroot\app.js" />
	</ItemGroup>

	<ItemGroup>
		<GuiSource Include="web\src\**\*.ts" />
		<GuiSource Include="web\styles.css" />
		<GuiSource Include="web\*.mjs" />
		<GuiSource Include="web\schema.fixture.json" />
		<GuiSource Include="..\plugins\rPDU2MQTT.Plugin.Tigo\wwwroot\*" />
	</ItemGroup>

	<!-- Builds the GUI bundle and runs its checks; skipped when node is not installed. -->
	<Target Name="BuildGuiAssets" BeforeTargets="BeforeBuild" Inputs="@(GuiSource)" Outputs="wwwroot\app.js;wwwroot\styles.css">
		<Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
			<Output TaskParameter="ExitCode" PropertyName="_NodeExitCode" />
		</Exec>
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/smoke.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/layout.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/sankey.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/update.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/animation.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/gauge.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/contradiction.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/tags.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/nodespage.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/discover.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/energyshow.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/history.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/trends.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/cost.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/node-trends.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/nodetrendskinds.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/nodedata-history.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/nodedata-filters.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
		<Exec Condition="'$(_NodeExitCode)' == '0'" Command="node web/trendsrecent.check.mjs" WorkingDirectory="$(MSBuildProjectDirectory)" />
