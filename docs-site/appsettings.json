{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Build": "Information",
      "Netdocs": "Information",
      "Microsoft": "Warning"
    }
  },
  "Netdocs": {
    "siteName": "rPDU2MQTT",
    "siteAuthor": "XtremeOwnage",
    "siteUrl": "https://xtremeownage.github.io/rPDU2MQTT/",
    "siteDescription": "Bridge Vertiv/Geist rack PDUs and other energy sources to MQTT, Home Assistant, Prometheus and EmonCMS.",
    "repoUrl": "https://github.com/XtremeOwnage/rPDU2MQTT",
    "repoName": "XtremeOwnage/rPDU2MQTT",
    "editUri": "edit/main/docs-site/docs/",
    "docsDir": "docs",
    "siteDir": "site",

    "theme": {
      "name": "material",
      "language": "en",
      "font": { "text": "Roboto", "code": "Roboto Mono" },
      "palette": [
        { "scheme": "slate", "primary": "indigo", "accent": "indigo", "toggle": { "icon": "material/brightness-4", "name": "Switch to light mode" } },
        { "scheme": "default", "primary": "indigo", "accent": "indigo", "toggle": { "icon": "material/brightness-7", "name": "Switch to dark mode" } }
      ],
      "features": [
        "navigation.tabs",
        "navigation.sections",
        "navigation.top",
        "navigation.footer",
        "navigation.indexes",
        "navigation.path",
        "search.suggest",
        "search.highlight",
        "search.share",
        "content.code.copy",
        "content.action.edit",
        "content.action.view",
        "content.tooltips",
        "toc.follow",
        "toc.integrate"
      ]
    },

    "nav": [
      { "title": "Home", "path": "index.md", "icon": "home" },
      {
        "title": "Getting started",
        "icon": "rocket-launch",
        "children": [
          { "path": "getting-started/index.md" },
          { "path": "getting-started/installation.md" },
          { "path": "getting-started/quickstart.md" },
          { "path": "getting-started/upgrading-to-2.0.md" }
        ]
      },
      {
        "title": "Configuration",
        "icon": "cog",
        "children": [
          { "path": "configuration/index.md" },
          { "path": "configuration/environment-variables.md" },
          { "path": "configuration/mqtt.md" },
          { "path": "configuration/pdus.md" },
          { "path": "configuration/overrides.md" },
          { "path": "configuration/oneview.md" },
          { "path": "configuration/home-assistant.md" },
          { "path": "configuration/history.md" },
          { "path": "configuration/prometheus.md" },
          { "path": "configuration/emoncms.md" },
          { "path": "configuration/gui.md" },
          { "path": "configuration/logging.md" }
        ]
      },
      {
        "title": "Energy flow",
        "icon": "transmission-tower",
        "children": [
          { "path": "energy-flow/index.md" },
          { "path": "energy-flow/sources.md" },
          { "path": "energy-flow/totals.md" },
          { "path": "energy-flow/panels.md" },
          { "path": "energy-flow/floor-plans.md" }
        ]
      },
      {
        "title": "Web GUI",
        "icon": "monitor-dashboard",
        "children": [
          { "path": "gui/index.md" },
          { "path": "gui/sources.md" },
          { "path": "gui/energy-flow.md" },
          { "path": "gui/integrations-and-destinations.md" },
          { "path": "gui/system.md" }
        ]
      },
      {
        "title": "Deployment",
        "icon": "cloud-upload",
        "children": [
          { "path": "deployment/index.md" },
          { "path": "deployment/docker.md" },
          { "path": "deployment/docker-compose.md" },
          { "path": "deployment/helm.md" },
          { "path": "deployment/argo-cd.md" },
          { "path": "deployment/kubernetes-crd.md" }
        ]
      },
      {
        "title": "Reference",
        "icon": "book-open-variant",
        "children": [
          { "path": "reference/mqtt-topics.md" },
          { "path": "reference/rest-api.md" },
          { "path": "reference/health.md" },
          { "path": "reference/cli.md" },
          {
            "title": "Settings",
            "icon": "tune",
            "children": [
              { "path": "reference/settings/index.md" },
              { "path": "reference/settings/mqtt.md" },
              { "path": "reference/settings/pdus.md" },
              { "path": "reference/settings/overrides.md" },
              { "path": "reference/settings/homeassistant.md" },
              { "path": "reference/settings/energyflow.md" },
              { "path": "reference/settings/history.md" },
              { "path": "reference/settings/prometheus.md" },
              { "path": "reference/settings/emoncms.md" },
              { "path": "reference/settings/modbus.md" },
              { "path": "reference/settings/gui.md" },
              { "path": "reference/settings/api.md" },
              { "path": "reference/settings/health.md" },
              { "path": "reference/settings/logging.md" },
              { "path": "reference/settings/debug.md" },
              { "path": "reference/settings/planstorage.md" },
