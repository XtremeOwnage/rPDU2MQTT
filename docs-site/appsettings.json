              { "path": "reference/settings/plugins.md" }
            ]
          }
        ]
      },
      {
        "title": "Development",
        "icon": "code-braces",
        "children": [
          { "path": "development/index.md" },
          { "path": "development/data-flow.md" },
          { "path": "development/writing-plugins.md" },
          { "path": "development/plugins-plan.md" },
          {
            "title": "Design history",
            "icon": "history",
            "children": [
              { "path": "development/design/v2-architecture.md" },
              { "path": "development/design/v3-orleans-migration.md" },
              { "path": "development/design/v4-plugins.md" }
            ]
          }
        ]
      }
    ],

    "plugins": [
      { "name": "search", "options": { "lang": "en" } },
      { "name": "meta" }
    ],

    "validation": { "links": true, "anchors": true, "orphanPages": true },

    "markdownExtensions": [
      { "name": "admonition" },
      { "name": "pymdownx.details" },
      { "name": "attr_list" },
      { "name": "toc", "options": { "permalink": true } },
      { "name": "pymdownx.tabbed", "options": { "alternate_style": true } },
      { "name": "pymdownx.superfences" }
    ],

    "extra": {
      "social": [
        { "icon": "fontawesome/brands/github", "link": "https://github.com/XtremeOwnage/rPDU2MQTT" }
      ]
    }
  }
}
